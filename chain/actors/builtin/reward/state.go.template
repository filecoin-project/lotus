var _ State = (*state{{.v}})(nil)

func load{{.v}}(store adt.Store, root cid.Cid) (State, error) {
	out := state{{.v}}{store: store}
	err := store.Get(store.Context(), root, &out)
	if err != nil {
		return nil, err
	}
	return &out, nil
}

{{if (ge .v 19)}}func make{{.v}}(store adt.Store, currRealizedPower abi.StoragePower) (State, error) {
	st, err := reward{{.v}}.ConstructState(store, currRealizedPower)
	if err != nil {
		return nil, err
	}
	return &state{{.v}}{State: *st, store: store}, nil
}{{else}}func make{{.v}}(store adt.Store, currRealizedPower abi.StoragePower) (State, error) {
	out := state{{.v}}{store: store}
	out.State = *reward{{.v}}.ConstructState(currRealizedPower)
	return &out, nil
}{{end}}

